# ==========================================
# OpenSide .gitignore
# Swift, macOS, Xcode, Build Artifacts & Credentials
# ==========================================

# macOS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?

# Swift Package Manager & Build Outputs
.build/
Packages/
Package.pins
.swiftpm/configuration/
.swiftpm/security/

# Compiled App & Binaries
*.app/
*.app
*.dSYM/
*.ipa
*.pkg
*.dmg

# Xcode & User Configurations
build/
DerivedData/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Fastlane & Tooling Artifacts
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# Security, Credentials & Sensitive Files
*.p12
*.cer
*.crt
*.der
*.p8
*.pem
*.key
*.mobileprovision
*.provisionprofile
*Secrets*
*secrets*
*Credentials*
*credentials*
*token*
*Token*
*id_rsa*
*id_ed25519*
.env
.env.*
!.env.example
*.keychain
*.keychain-db

# Temporary & Editor Files
*.log
*.tmp
*.swp
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# 생성되는 Xcode 프로젝트 (원본은 project.yml, xcodegen generate 로 재생성)
*.xcodeproj/

# 개발자별 서명 설정 (Team ID 등)
Local.xcconfig

# 로컬 조사 기록과 릴리스 도구 (공개 배포 대상 아님)
docs/
